{
  "name": "glyph-morph",
  "version": "0.1.0",
  "description": "Text that morphs between strings in one wave across its letters: shared letters blur and swap, extra letters write on with a glow, removed letters backspace. Vanilla JS, a custom element and React.",
  "type": "module",
  "sideEffects": ["./src/element.js"],
  "exports": {
    ".": { "types": "./src/glyph-morph.d.ts", "default": "./src/glyph-morph.js" },
    "./element": { "types": "./src/element.d.ts", "default": "./src/element.js" },
    "./react": { "types": "./src/react.d.ts", "default": "./src/react.js" }
  },
  "files": ["src"],
  "peerDependencies": { "react": ">=18" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "keywords": ["animation", "text", "morph", "transition", "blur", "glow", "react", "web-component"],
  "repository": { "type": "git", "url": "git+https://github.com/PriyanshuMallick/glyph-morph.git", "directory": "web" },
  "homepage": "https://github.com/PriyanshuMallick/glyph-morph#readme",
  "license": "MIT"
}
