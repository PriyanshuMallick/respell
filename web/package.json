{
  "name": "respell",
  "version": "0.1.0",
  "description": "Text that morphs between strings in one wave across its letters: shared letters blur and swap, extra letters write on with a glow, removed letters backspace. Vanilla JS, a custom element and React.",
  "type": "module",
  "sideEffects": [
    "./dist/element.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/respell.d.ts",
      "default": "./dist/respell.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "animation",
    "text",
    "morph",
    "transition",
    "blur",
    "glow",
    "react",
    "web-component"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PriyanshuMallick/respell.git",
    "directory": "web"
  },
  "homepage": "https://github.com/PriyanshuMallick/respell#readme",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
